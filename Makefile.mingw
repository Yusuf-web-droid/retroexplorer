# Modern MinGW can produce a 32-bit binary. Use an i686 MinGW toolchain.
# Run: mingw32-make -f Makefile.mingw

CXX = i686-w64-mingw32-g++
TARGET = retroexplorer.exe
CXXFLAGS = -Os -Wall -march=i586 -fno-exceptions -fno-rtti -DWINVER=0x0410 -D_WIN32_WINNT=0x0410
LDFLAGS = -mwindows -Wl,--major-subsystem-version,4 -Wl,--minor-subsystem-version,10
LDLIBS = -lole32 -loleaut32 -luuid

all: $(TARGET)

$(TARGET): browser.cpp
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $< $(LDLIBS)

clean:
	rm -f $(TARGET)
